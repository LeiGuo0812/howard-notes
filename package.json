{
  "name": "@jackyzha0/quartz",
  "description": "🌱 publish your digital garden and notes as a website",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "author": "jackyzha0 <j.zhao2k19@gmail.com>",
  "license": "MIT",
  "homepage": "https://quartz.jzhao.xyz",
  "repository": {
    "type": "git",
    "url": "https://github.com/jackyzha0/quartz.git"
  },
  "scripts": {
    "quartz": "./quartz/bootstrap-cli.mjs",
    "docs": "npx quartz build --serve -d docs",
    "check": "tsc --noEmit && npx prettier . --check",
    "format": "npx prettier . --write",
    "test": "tsx --test",
    "profile": "0x -D prof ./quartz/bootstrap-cli.mjs build --concurrency=1",
    "install-plugins": "npx tsx ./quartz/plugins/loader/install-plugins.ts",
    "build": "node scripts/prepare-content.mjs && node quartz/bootstrap-cli.mjs build && node scripts/finalize-site.mjs && node scripts/build-admin.mjs",
    "dev": "node scripts/prepare-content.mjs && node quartz/bootstrap-cli.mjs build --serve --baseDir howard-notes",
    "export": "node scripts/prepare-content.mjs",
    "sync": "node scripts/sync-notes.mjs",
    "preview": "node scripts/preview.mjs",
    "test:publish": "node --test scripts/pagination.test.mjs scripts/library.test.mjs scripts/article-thumbnail.test.mjs scripts/site-pages.test.mjs scripts/import-memos.test.mjs scripts/memory-attachment-migration.test.mjs scripts/site-icon.test.mjs scripts/graph-runtime.test.mjs scripts/browser-cache-lifecycle.test.mjs scripts/cloudflare-assets.test.mjs scripts/mermaid-reader.test.mjs scripts/sync.test.mjs scripts/sync.integration.test.mjs admin/home-memory-previews.test.mjs admin/tag-input.test.mjs admin/github.test.mjs admin/images.test.mjs admin/formatting.test.mjs admin/article-recovery.test.mjs admin/local-trash.test.mjs admin/deployment.test.mjs admin/preview.test.mjs admin/site-preview.test.mjs admin/runtime-publish.test.mjs admin/panel-window.test.mjs admin/auth.test.mjs auth-service/worker.test.mjs content-service/worker.test.mjs content-service/export-images.test.mjs content-service/session.test.mjs content-service/memories.test.mjs scripts/private-note-migration.test.mjs scripts/backup-live.test.mjs scripts/content-security.test.mjs admin/personal-library.test.mjs admin/private-notes-core.test.mjs admin/private-diagrams.test.mjs admin/mermaid-theme.test.mjs admin/mermaid-svg-style.test.mjs admin/article-share-core.test.mjs admin/article-share-lifecycle.test.mjs admin/article-export-renderer.test.mjs admin/article-export-pdf.test.mjs admin/public-library.test.mjs admin/durable-drafts.test.mjs admin/memory-recovery.test.mjs content-service/personal-notes.test.mjs content-service/backups.test.mjs content-service/publication-jobs.test.mjs content-service/public-attachments.test.mjs content-service/owner-verification.test.mjs content-service/owner-verification.integration.test.mjs admin/backup-manager.test.mjs && tsx --test quartz/components/scripts/browsing.test.ts quartz/util/article-links.test.ts quartz/runtime/render.test.ts runtime/projection.test.mjs runtime/cache.test.mjs runtime/syntax.test.ts quartz/components/renderPage.test.ts quartz/util/article-security.test.ts runtime/private-reading.test.ts",
    "verify:site": "node scripts/verify-site.mjs",
    "content:sync": "node --use-env-proxy scripts/prepare-content.mjs && node --use-env-proxy scripts/content-sync.mjs",
    "content:seed": "node scripts/content-sync.mjs --seed-sql .local/content-import.sql",
    "build:cloudflare": "npm run build && node scripts/prepare-cloudflare-assets.mjs",
    "notes:import-private": "node --use-env-proxy scripts/import-private-notes.mjs",
    "notes:export-private": "node --use-env-proxy scripts/export-personal-notes.mjs",
    "backup:export": "node --use-env-proxy scripts/backup-export.mjs",
    "backup:verify": "node scripts/backup-verify.mjs",
    "backup:live-verify": "node --use-env-proxy scripts/backup-live-verify.mjs"
  },
  "engines": {
    "npm": ">=10.9.2",
    "node": ">=22"
  },
  "keywords": [
    "site generator",
    "ssg",
    "digital-garden",
    "markdown",
    "blog",
    "quartz"
  ],
  "bin": {
    "quartz": "./quartz/bootstrap-cli.mjs"
  },
